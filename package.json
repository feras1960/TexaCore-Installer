{
  "name": "texacore-installer",
  "version": "2.0.6",
  "buildDate": "2026-10-29T00:21:52.421Z",
  "description": "TexaCore ERP — Local Desktop Server (hybrid)",
  "main": "src/main.js",
  "author": "TexaCore <info@texacore.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/",
    "release:assets": "node scripts/release-assets.js",
    "sync:baseline": "node scripts/sync-baseline.js",
    "sync:migrations": "node scripts/sync-migrations.js",
    "sync:frontend": "REQUIRE_LOCAL_FONTS=1 node scripts/sync-frontend.js",
    "prepare:pg:mac": "bash scripts/prepare-pg-mac.sh",
    "prepare:pg:win": "node scripts/prepare-pg-win.js",
    "check:build": "node scripts/prebuild-checks.js",
    "build:mac": "node scripts/stamp-build-date.js && node scripts/prebuild-checks.js --platform mac && node scripts/pack-baseline.js && node -r ./scripts/builder-patches.js ./node_modules/electron-builder/cli.js --mac",
    "build:win": "node scripts/stamp-build-date.js && node scripts/prebuild-checks.js --platform win && node scripts/pack-baseline.js && node -r ./scripts/builder-patches.js ./node_modules/electron-builder/cli.js --win",
    "build:all": "node scripts/stamp-build-date.js && node scripts/prebuild-checks.js --platform all && node scripts/pack-baseline.js && node -r ./scripts/builder-patches.js ./node_modules/electron-builder/cli.js --mac --win",
    "build": "node scripts/prebuild-checks.js --platform all && electron-builder",
    "release:patch": "./release.sh patch",
    "release:minor": "./release.sh minor",
    "release:major": "./release.sh major",
    "publish:mac": "node scripts/stamp-build-date.js && node scripts/prebuild-checks.js --platform mac && node scripts/pack-baseline.js && node -r ./scripts/builder-patches.js ./node_modules/electron-builder/cli.js --mac --publish always",
    "publish:win": "node scripts/stamp-build-date.js && node scripts/prebuild-checks.js --platform win && node scripts/pack-baseline.js && node -r ./scripts/builder-patches.js ./node_modules/electron-builder/cli.js --win --publish always",
    "publish": "node scripts/stamp-build-date.js && node scripts/prebuild-checks.js --platform all && node scripts/pack-baseline.js && node -r ./scripts/builder-patches.js ./node_modules/electron-builder/cli.js --mac --win --publish always"
  },
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "dunder-proto": "^1.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "mdb-reader": "^3.2.0",
    "pg": "^8.20.0",
    "side-channel": "^1.1.0",
    "side-channel-map": "^1.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/tajawal": "^5.2.7",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.9.0"
  },
  "build": {
    "afterPack": "./scripts/afterPack.cjs",
    "appId": "com.texacore.installer",
    "productName": "TexaCore ERP",
    "copyright": "Copyright © 2026 TexaCore",
    "publish": [
      {
        "provider": "github",
        "owner": "feras1960",
        "repo": "TexaCore-Installer",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "compression": "maximum",
    "files": [
      "src/**/*",
      "!src/bootstrap/*.sql",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "build/baseline-pack",
        "to": "baseline",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/trayTemplate.png",
        "to": "build/trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "build/trayTemplate@2x.png"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleIconName": "TexaCore",
        "NSDesktopFolderUsageDescription": "TexaCore needs access to your Desktop folder to find the company file you choose and to keep your company file beside it.",
        "NSDocumentsFolderUsageDescription": "TexaCore needs access to your Documents folder to save your company file there (Documents/TexaCore) and to find a file you choose.",
        "NSDownloadsFolderUsageDescription": "TexaCore needs access to your Downloads folder to find the company file you choose and to keep your company file beside it.",
        "NSRemovableVolumesUsageDescription": "TexaCore needs access to removable drives to open a company file you choose on them and to keep your company file there.",
        "NSNetworkVolumesUsageDescription": "TexaCore needs access to network drives to open a company file you choose on them and to keep your company file there.",
        "NSFileProviderDomainUsageDescription": "TexaCore needs access to your cloud storage (iCloud Drive, OneDrive, ...) to find and open the company file you choose."
      },
      "extraResources": [
        {
          "from": "bin/macos-arm64",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        },
        {
          "from": "build/lproj/en.lproj",
          "to": "en.lproj",
          "filter": [
            "InfoPlist.strings"
          ]
        },
        {
          "from": "build/lproj/ar.lproj",
          "to": "ar.lproj",
          "filter": [
            "InfoPlist.strings"
          ]
        },
        {
          "from": "build/lproj/uk.lproj",
          "to": "uk.lproj",
          "filter": [
            "InfoPlist.strings"
          ]
        },
        {
          "from": "build/lproj/ru.lproj",
          "to": "ru.lproj",
          "filter": [
            "InfoPlist.strings"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "TexaCore-ERP-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "bin/windows-x64",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/vcredist",
          "to": "vcredist",
          "filter": [
            "*.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TexaCore-ERP-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "license": "build/eula.rtf",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TexaCore ERP",
      "deleteAppDataOnUninstall": false,
      "artifactName": "TexaCore-ERP-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "TexaCore-ERP-${version}-${arch}.${ext}",
      "background": "build/dmg-background.png",
      "iconSize": 110,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 130,
          "y": 218
        },
        {
          "x": 410,
          "y": 218,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "texacore": {
    "secretsAtRest": {
      "darwin": "auto",
      "win32": "off"
    }
  }
}
